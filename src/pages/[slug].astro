---
import "../styles/global.css";
import { readAllPages, readPage, renderMarkdown } from "@/lib/wiki";

const slug = Astro.params.slug || "rap";
const page = readPage(slug);
const pages = readAllPages();
const html = renderMarkdown(page.markdown, pages);
const isHomePage = page.slug === "rap";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://embed.music.apple.com" />
    <link rel="preconnect" href="https://music.apple.com" />
    <title>{page.title}</title>
  </head>
  <body>
    <main class="page-shell">
      <section class="toolbar" aria-label="Page actions">
        <nav class="breadcrumbs" aria-label="Breadcrumbs">
          <button class="back-button" type="button" data-back-button aria-label="Go back">Back</button>
          <ol>
            <li><a href="/rap">Rap</a></li>
            {!isHomePage && (
              <>
                <li aria-hidden="true">/</li>
                <li aria-current="page">{page.title}</li>
              </>
            )}
          </ol>
        </nav>
        <div class="toolbar-actions">
          <span class="save-status" data-save-status></span>
          <button class="text-button" type="button" data-history-toggle>History</button>
          <button class="text-button" type="button" data-edit-toggle>Edit</button>
          <button class="text-button is-primary" type="button" data-save hidden>Save</button>
        </div>
      </section>

      <article class="wiki-page" data-view>
        <div set:html={html} />
      </article>

      <section class="editor" data-editor hidden>
        <textarea aria-label={`Markdown for ${page.title}`} data-markdown>{page.markdown}</textarea>
      </section>

      <section class="history-panel" data-history-panel hidden aria-label="Version history">
        <div class="history-header">
          <div>
            <h2>History</h2>
            <p>Local Git versions for this post.</p>
          </div>
          <span class="history-status" data-history-status></span>
        </div>
        <div class="history-layout">
          <ol class="history-list" data-history-list></ol>
          <article class="history-preview">
            <header class="history-preview-header">
              <div>
                <strong data-history-version-title>Select a version</strong>
                <span data-history-version-meta>Choose a commit to preview it.</span>
              </div>
              <button class="text-button is-primary" type="button" data-history-restore disabled>Restore</button>
            </header>
            <div class="wiki-page history-preview-body" data-history-preview></div>
          </article>
        </div>
      </section>
    </main>

    <div class="preview-card" data-preview-card>
      <strong data-preview-title></strong>
      <p data-preview-body></p>
      <div class="preview-apple-music-slot" data-preview-apple-music-slot>
        <div class="preview-apple-music-loading" data-preview-apple-music-loading hidden>
          Loading Apple Music...
        </div>
      </div>
      <div class="preview-youtube-slot" data-preview-youtube-slot hidden>
        <div class="preview-youtube-loading" data-preview-youtube-loading hidden>
          Loading YouTube...
        </div>
      </div>
    </div>

    <div class="note-popover" data-note-popover role="dialog" aria-label="Note" hidden>
      <div class="note-popover-read" data-note-read>
        <strong>Note</strong>
        <p data-note-read-body></p>
        <div class="note-popover-actions">
          <button class="note-button is-danger" type="button" data-note-delete>Delete note</button>
        </div>
      </div>
      <form class="note-popover-form" data-note-form hidden>
        <label for="note-popover-input">Add note</label>
        <textarea id="note-popover-input" rows="3" data-note-input></textarea>
        <p class="note-popover-error" data-note-error hidden></p>
        <div class="note-popover-actions">
          <button class="note-button" type="button" data-note-cancel>Cancel</button>
          <button class="note-button is-primary" type="submit" data-note-submit>Add note</button>
        </div>
      </form>
    </div>

    <script define:vars={{ slug: page.slug }}>
      const editToggle = document.querySelector("[data-edit-toggle]");
      const historyToggle = document.querySelector("[data-history-toggle]");
      const saveButton = document.querySelector("[data-save]");
      const saveStatus = document.querySelector("[data-save-status]");
      const backButton = document.querySelector("[data-back-button]");
      const view = document.querySelector("[data-view]");
      const editor = document.querySelector("[data-editor]");
      const textarea = document.querySelector("[data-markdown]");
      const historyPanel = document.querySelector("[data-history-panel]");
      const historyStatus = document.querySelector("[data-history-status]");
      const historyList = document.querySelector("[data-history-list]");
      const historyPreview = document.querySelector("[data-history-preview]");
      const historyVersionTitle = document.querySelector("[data-history-version-title]");
      const historyVersionMeta = document.querySelector("[data-history-version-meta]");
      const historyRestore = document.querySelector("[data-history-restore]");
      const previewCard = document.querySelector("[data-preview-card]");
      const previewTitle = previewCard.querySelector("[data-preview-title]");
      const previewBody = previewCard.querySelector("[data-preview-body]");
      const previewAppleMusicSlot = previewCard.querySelector("[data-preview-apple-music-slot]");
      const previewAppleMusicLoading = previewCard.querySelector("[data-preview-apple-music-loading]");
      const previewYoutubeSlot = previewCard.querySelector("[data-preview-youtube-slot]");
      const previewYoutubeLoading = previewCard.querySelector("[data-preview-youtube-loading]");
      const notePopover = document.querySelector("[data-note-popover]");
      const noteRead = notePopover.querySelector("[data-note-read]");
      const noteReadBody = notePopover.querySelector("[data-note-read-body]");
      const noteForm = notePopover.querySelector("[data-note-form]");
      const noteInput = notePopover.querySelector("[data-note-input]");
      const noteError = notePopover.querySelector("[data-note-error]");
      const noteCancel = notePopover.querySelector("[data-note-cancel]");
      const noteDelete = notePopover.querySelector("[data-note-delete]");
      const noteSubmit = notePopover.querySelector("[data-note-submit]");
      const appleMusicFrames = new Map();
      const youtubeFrames = new Map();
      const historyCommits = new Map();
      const historyDateFormatter = new Intl.DateTimeFormat(undefined, {
        dateStyle: "medium",
        timeStyle: "short",
      });

      let editing = false;
      let historyLoaded = false;
      let selectedHistoryRevision = "";
      let previewHideTimer;
      let noteHideTimer;
      let activeNoteElement = null;
      let pendingNoteSelection = null;

      backButton.addEventListener("click", () => {
        const referrer = document.referrer ? new URL(document.referrer) : null;
        const cameFromThisSite = referrer?.origin === window.location.origin;

        if (cameFromThisSite && window.history.length > 1) {
          window.history.back();
          return;
        }

        window.location.href = "/rap";
      });

      function setEditing(nextEditing) {
        editing = nextEditing;
        view.hidden = editing;
        editor.hidden = !editing;
        saveButton.hidden = !editing;
        editToggle.textContent = editing ? "Cancel" : "Edit";
        saveStatus.textContent = "";
        hideNotePopover();
        if (editing) {
          historyPanel.hidden = true;
          historyToggle.classList.remove("is-active");
        }
        if (editing) textarea.focus();
      }

      editToggle.addEventListener("click", () => setEditing(!editing));

      function formatHistoryDate(value) {
        return historyDateFormatter.format(new Date(value));
      }

      function setHistoryStatus(message) {
        historyStatus.textContent = message;
      }

      async function fetchJson(url, options) {
        const response = await fetch(url, options);

        if (!response.ok) {
          throw new Error(await response.text());
        }

        return response.json();
      }

      function setHistorySelection(revision) {
        selectedHistoryRevision = revision;
        historyList.querySelectorAll("[data-history-revision]").forEach((button) => {
          button.classList.toggle("is-selected", button.dataset.historyRevision === revision);
        });
      }

      async function selectHistoryRevision(revision) {
        const commit = historyCommits.get(revision);
        if (!commit) return;

        setHistorySelection(revision);
        setHistoryStatus("Loading version...");
        historyRestore.disabled = true;
        historyVersionTitle.textContent = commit.subject || commit.shortHash;
        historyVersionMeta.textContent = `${commit.shortHash} · ${formatHistoryDate(commit.authorDate)}`;

        try {
          const data = await fetchJson(`/api/history/version?slug=${encodeURIComponent(slug)}&revision=${encodeURIComponent(revision)}`);
          historyPreview.innerHTML = data.version.html;
          historyRestore.disabled = false;
          setHistoryStatus("");
        } catch (error) {
          historyPreview.textContent = "";
          setHistoryStatus("Could not load version");
          console.error(error);
        }
      }

      function renderHistory(commits) {
        historyList.innerHTML = "";
        historyCommits.clear();

        if (commits.length === 0) {
          const emptyItem = document.createElement("li");
          emptyItem.className = "history-empty";
          emptyItem.textContent = "No committed versions yet.";
          historyList.append(emptyItem);
          return;
        }

        commits.forEach((commit) => {
          historyCommits.set(commit.hash, commit);

          const item = document.createElement("li");
          const button = document.createElement("button");
          const subject = document.createElement("strong");
          const meta = document.createElement("span");

          button.type = "button";
          button.dataset.historyRevision = commit.hash;
          subject.textContent = commit.subject || commit.shortHash;
          meta.textContent = `${commit.shortHash} · ${formatHistoryDate(commit.authorDate)}`;

          button.append(subject, meta);
          item.append(button);
          historyList.append(item);
        });
      }

      async function loadHistory() {
        setHistoryStatus("Loading history...");

        try {
          const data = await fetchJson(`/api/history?slug=${encodeURIComponent(slug)}`);
          renderHistory(data.commits);
          historyLoaded = true;
          setHistoryStatus("");

          if (data.commits.length > 0) {
            await selectHistoryRevision(data.commits[0].hash);
          }
        } catch (error) {
          setHistoryStatus("Could not load history");
          console.error(error);
        }
      }

      historyToggle.addEventListener("click", async () => {
        const opening = historyPanel.hidden;
        historyPanel.hidden = !opening;
        historyToggle.classList.toggle("is-active", opening);

        if (opening) {
          if (editing) setEditing(false);
          if (!historyLoaded) {
            await loadHistory();
          }
        }
      });

      historyList.addEventListener("click", async (event) => {
        const button = event.target.closest("[data-history-revision]");
        if (!button) return;
        await selectHistoryRevision(button.dataset.historyRevision);
      });

      historyRestore.addEventListener("click", async () => {
        if (!selectedHistoryRevision) return;

        const confirmed = window.confirm("Restore this version? The restored content will be saved as a new version.");
        if (!confirmed) return;

        historyRestore.disabled = true;
        setHistoryStatus("Restoring...");

        try {
          await fetchJson("/api/history/restore", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ slug, revision: selectedHistoryRevision }),
          });
          window.location.reload();
        } catch (error) {
          setHistoryStatus("Could not restore");
          historyRestore.disabled = false;
          console.error(error);
        }
      });

      function setTaskMarkdownLine(lineIndex, checked) {
        const lines = textarea.value.replace(/\r\n/g, "\n").split("\n");
        const line = lines[lineIndex];

        if (typeof line !== "string") {
          throw new Error("Could not find the todo item in the source Markdown.");
        }

        lines[lineIndex] = line.replace(/^(\s*[-*+]\s+\[)( |x|X)(\]\s+)/, `$1${checked ? "x" : " "}$3`);

        if (lines[lineIndex] === line) {
          throw new Error("Could not update the todo item in the source Markdown.");
        }

        textarea.value = lines.join("\n");
      }

      async function saveMarkdown(markdown) {
        const response = await fetch("/api/save", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ slug, markdown }),
        });

        if (!response.ok) {
          throw new Error(await response.text());
        }

        return response.json();
      }

      function normalizeInlineText(value) {
        return value.replace(/\s+/g, " ").trim();
      }

      function straightQuotes(value) {
        return value.replace(/[“”]/g, "\"").replace(/[‘’]/g, "'");
      }

      function escapeInlineNoteText(value) {
        return normalizeInlineText(value).replace(/\}\}/g, "}").replace(/\|/g, "/");
      }

      function lineStartOffset(lines, lineIndex) {
        return lines.slice(0, lineIndex).reduce((offset, line) => offset + line.length + 1, 0);
      }

      function sourceCandidatesForSelection(selectedText) {
        const normalized = normalizeInlineText(selectedText);
        const straight = straightQuotes(normalized);
        const baseCandidates = Array.from(new Set([normalized, straight])).filter(Boolean);
        const candidates = [];

        baseCandidates.forEach((candidate) => {
          candidates.push(`[[${candidate}]]`, `***${candidate}***`, `**${candidate}**`, `*${candidate}*`, candidate);
        });

        return Array.from(new Set(candidates));
      }

      function findSelectionSource(markdown, selectedText, sourceLineIndex) {
        const lines = markdown.replace(/\r\n/g, "\n").split("\n");
        const candidates = sourceCandidatesForSelection(selectedText);

        if (Number.isInteger(sourceLineIndex) && sourceLineIndex >= 0 && sourceLineIndex < lines.length) {
          const line = lines[sourceLineIndex];
          const candidate = candidates.find((item) => line.includes(item));

          if (candidate) {
            const index = line.indexOf(candidate);
            const start = lineStartOffset(lines, sourceLineIndex) + index;
            return { start, end: start + candidate.length, source: candidate };
          }
        }

        const candidate = candidates.find((item) => markdown.includes(item));
        if (!candidate) return null;

        const start = markdown.indexOf(candidate);
        return { start, end: start + candidate.length, source: candidate };
      }

      function addNoteToMarkdown(markdown, selectedText, noteBody, sourceLineIndex) {
        const match = findSelectionSource(markdown, selectedText, sourceLineIndex);
        if (!match) return null;

        const safeNoteBody = escapeInlineNoteText(noteBody);
        const replacement = `{{note ${match.source} | ${safeNoteBody}}}`;
        return `${markdown.slice(0, match.start)}${replacement}${markdown.slice(match.end)}`;
      }

      function deleteNoteFromMarkdown(markdown, source, fallbackText) {
        if (!source || !markdown.includes(source)) return null;
        return markdown.replace(source, fallbackText || "");
      }

      function getSelectionSourceLineIndex(selection) {
        const node = selection.anchorNode instanceof Element ? selection.anchorNode : selection.anchorNode?.parentElement;
        const sourceElement = node?.closest("[data-source-line-index]");
        const sourceLineIndex = Number(sourceElement?.dataset.sourceLineIndex);
        return Number.isInteger(sourceLineIndex) ? sourceLineIndex : null;
      }

      function getSelectionRect(selection) {
        if (selection.rangeCount === 0) return null;
        const range = selection.getRangeAt(0);
        const rect = range.getBoundingClientRect();

        if (rect.width || rect.height) return rect;
        return range.getClientRects()[0] || null;
      }

      function positionNotePopover(rect) {
        const popoverWidth = 320;
        const left = Math.max(16, Math.min(rect.left + rect.width / 2 - popoverWidth / 2, window.innerWidth - popoverWidth - 16));
        notePopover.style.left = `${left}px`;
        notePopover.style.top = `${rect.bottom + window.scrollY + 10}px`;
      }

      function hideNotePopover() {
        window.clearTimeout(noteHideTimer);
        notePopover.hidden = true;
        activeNoteElement = null;
        pendingNoteSelection = null;
        noteError.hidden = true;
        noteError.textContent = "";
      }

      function scheduleHideNotePopover() {
        window.clearTimeout(noteHideTimer);
        noteHideTimer = window.setTimeout(hideNotePopover, 140);
      }

      function showReadNotePopover(noteElement, rect) {
        window.clearTimeout(noteHideTimer);
        activeNoteElement = noteElement;
        pendingNoteSelection = null;
        noteRead.hidden = false;
        noteForm.hidden = true;
        noteReadBody.textContent = noteElement.dataset.noteBody || "";
        positionNotePopover(rect);
        notePopover.hidden = false;
      }

      function showAddNotePopover(selection, rect) {
        const selectedText = normalizeInlineText(selection.toString());
        if (!selectedText) return;

        window.clearTimeout(noteHideTimer);
        activeNoteElement = null;
        pendingNoteSelection = {
          text: selectedText,
          sourceLineIndex: getSelectionSourceLineIndex(selection),
        };
        noteRead.hidden = true;
        noteForm.hidden = false;
        noteInput.value = "";
        noteError.hidden = true;
        noteError.textContent = "";
        positionNotePopover(rect);
        notePopover.hidden = false;
        noteInput.focus();
      }

      function maybeShowSelectionNotePopover() {
        if (editing || !historyPanel.hidden) return;

        const selection = window.getSelection();
        if (!selection || selection.isCollapsed || selection.rangeCount === 0) return;
        if (!view.contains(selection.anchorNode) || !view.contains(selection.focusNode)) return;

        const range = selection.getRangeAt(0);
        const container = range.commonAncestorContainer instanceof Element
          ? range.commonAncestorContainer
          : range.commonAncestorContainer.parentElement;

        if (container?.closest(".inline-note")) return;

        const rect = getSelectionRect(selection);
        if (!rect) return;
        showAddNotePopover(selection, rect);
      }

      function closestElement(target, selector) {
        return target instanceof Element ? target.closest(selector) : null;
      }

      saveButton.addEventListener("click", async () => {
        saveButton.disabled = true;
        saveStatus.textContent = "Saving...";

        try {
          await saveMarkdown(textarea.value);
          saveStatus.textContent = "Saved";
          window.location.reload();
        } catch (error) {
          saveStatus.textContent = "Could not save";
          console.error(error);
        } finally {
          saveButton.disabled = false;
        }
      });

      noteForm.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (!pendingNoteSelection) return;

        const noteBody = noteInput.value.trim();
        if (!noteBody) {
          noteError.textContent = "Write a note first.";
          noteError.hidden = false;
          return;
        }

        const previousMarkdown = textarea.value;
        const nextMarkdown = addNoteToMarkdown(
          textarea.value,
          pendingNoteSelection.text,
          noteBody,
          pendingNoteSelection.sourceLineIndex,
        );

        if (!nextMarkdown) {
          noteError.textContent = "Could not find that exact text in the Markdown.";
          noteError.hidden = false;
          return;
        }

        noteSubmit.disabled = true;
        saveStatus.textContent = "Saving...";

        try {
          textarea.value = nextMarkdown;
          await saveMarkdown(textarea.value);
          saveStatus.textContent = "Saved";
          window.location.reload();
        } catch (error) {
          textarea.value = previousMarkdown;
          saveStatus.textContent = "Could not save";
          noteError.textContent = "Could not save note.";
          noteError.hidden = false;
          console.error(error);
        } finally {
          noteSubmit.disabled = false;
        }
      });

      noteCancel.addEventListener("click", hideNotePopover);

      noteDelete.addEventListener("click", async () => {
        if (!activeNoteElement) return;

        const previousMarkdown = textarea.value;
        const nextMarkdown = deleteNoteFromMarkdown(
          textarea.value,
          activeNoteElement.dataset.noteSource || "",
          activeNoteElement.dataset.noteText || "",
        );

        if (!nextMarkdown) {
          saveStatus.textContent = "Could not delete";
          return;
        }

        noteDelete.disabled = true;
        saveStatus.textContent = "Saving...";

        try {
          textarea.value = nextMarkdown;
          await saveMarkdown(textarea.value);
          saveStatus.textContent = "Saved";
          window.location.reload();
        } catch (error) {
          textarea.value = previousMarkdown;
          saveStatus.textContent = "Could not save";
          console.error(error);
        } finally {
          noteDelete.disabled = false;
        }
      });

      view.addEventListener("mouseup", () => window.setTimeout(maybeShowSelectionNotePopover, 0));
      view.addEventListener("keyup", (event) => {
        if (event.key === "Shift" || event.key.startsWith("Arrow")) {
          window.setTimeout(maybeShowSelectionNotePopover, 0);
        }
      });

      view.addEventListener("mouseover", (event) => {
        const noteElement = closestElement(event.target, ".inline-note");
        if (!noteElement) return;
        showReadNotePopover(noteElement, noteElement.getBoundingClientRect());
      });

      view.addEventListener("mouseout", (event) => {
        const noteElement = closestElement(event.target, ".inline-note");
        const relatedTarget = event.relatedTarget instanceof Node ? event.relatedTarget : null;
        if (!noteElement || (relatedTarget && notePopover.contains(relatedTarget))) return;
        scheduleHideNotePopover();
      });

      view.addEventListener("focusin", (event) => {
        const noteElement = closestElement(event.target, ".inline-note");
        if (!noteElement) return;
        showReadNotePopover(noteElement, noteElement.getBoundingClientRect());
      });

      view.addEventListener("click", (event) => {
        const noteElement = closestElement(event.target, ".inline-note");
        if (!noteElement) return;
        event.preventDefault();
        showReadNotePopover(noteElement, noteElement.getBoundingClientRect());
      });

      notePopover.addEventListener("mouseenter", () => window.clearTimeout(noteHideTimer));
      notePopover.addEventListener("mouseleave", scheduleHideNotePopover);

      document.addEventListener("click", (event) => {
        if (notePopover.hidden) return;
        if (notePopover.contains(event.target) || closestElement(event.target, ".inline-note")) return;
        const selection = window.getSelection();
        if (selection && !selection.isCollapsed && view.contains(selection.anchorNode)) return;
        hideNotePopover();
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") hideNotePopover();
      });

      view.addEventListener("change", async (event) => {
        const checkbox = event.target;
        if (!(checkbox instanceof HTMLInputElement) || !checkbox.classList.contains("todo-checkbox")) {
          return;
        }

        const previousMarkdown = textarea.value;
        const previousChecked = !checkbox.checked;
        checkbox.disabled = true;
        saveStatus.textContent = "Saving...";

        try {
          setTaskMarkdownLine(Number(checkbox.dataset.lineIndex), checkbox.checked);
          await saveMarkdown(textarea.value);
          saveStatus.textContent = "Saved";
        } catch (error) {
          textarea.value = previousMarkdown;
          checkbox.checked = previousChecked;
          saveStatus.textContent = "Could not save";
          console.error(error);
        } finally {
          checkbox.disabled = false;
        }
      });

      function hidePreview() {
        previewCard.classList.remove("is-visible");
        previewAppleMusicLoading.hidden = true;
        previewYoutubeLoading.hidden = true;
        appleMusicFrames.forEach((frame) => parkAppleMusicFrame(frame));
        youtubeFrames.forEach((frame) => parkYoutubeFrame(frame));
      }

      function parkAppleMusicFrame(frame) {
        frame.classList.remove("is-active", "is-loading");
      }

      function parkYoutubeFrame(frame) {
        frame.classList.remove("is-active", "is-loading");
      }

      function scheduleHidePreview() {
        previewHideTimer = window.setTimeout(hidePreview, 120);
      }

      function createAppleMusicFrame(src) {
        const frame = document.createElement("iframe");
        frame.className = "preview-apple-music";
        frame.title = "Apple Music preview";
        frame.allow = "autoplay *; encrypted-media *;";
        frame.frameBorder = "0";
        frame.height = "175";
        frame.loading = "eager";
        frame.sandbox = "allow-forms allow-popups allow-same-origin allow-scripts allow-top-navigation-by-user-activation";
        frame.dataset.loaded = "false";
        frame.dataset.src = src;
        frame.addEventListener("mouseenter", () => window.clearTimeout(previewHideTimer));
        frame.addEventListener("mouseleave", hidePreview);
        frame.addEventListener("load", () => {
          frame.dataset.loaded = "true";
          frame.classList.remove("is-loading");
          if (frame.classList.contains("is-active")) {
            previewAppleMusicLoading.hidden = true;
          }
        });
        frame.src = src;
        return frame;
      }

      function createYoutubeFrame(src) {
        const frame = document.createElement("iframe");
        frame.className = "preview-youtube";
        frame.title = "YouTube preview";
        frame.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
        frame.allowFullscreen = true;
        frame.frameBorder = "0";
        frame.loading = "eager";
        frame.sandbox = "allow-forms allow-popups allow-presentation allow-same-origin allow-scripts allow-top-navigation-by-user-activation";
        frame.dataset.loaded = "false";
        frame.dataset.src = src;
        frame.addEventListener("mouseenter", () => window.clearTimeout(previewHideTimer));
        frame.addEventListener("mouseleave", hidePreview);
        frame.addEventListener("load", () => {
          frame.dataset.loaded = "true";
          frame.classList.remove("is-loading");
          if (frame.classList.contains("is-active")) {
            previewYoutubeLoading.hidden = true;
          }
        });
        frame.src = src;
        return frame;
      }

      function getAppleMusicFrame(src) {
        if (!appleMusicFrames.has(src)) {
          const frame = createAppleMusicFrame(src);
          appleMusicFrames.set(src, frame);
          previewAppleMusicSlot.append(frame);
        }

        return appleMusicFrames.get(src);
      }

      function getYoutubeFrame(src) {
        if (!youtubeFrames.has(src)) {
          const frame = createYoutubeFrame(src);
          youtubeFrames.set(src, frame);
          previewYoutubeSlot.append(frame);
        }

        return youtubeFrames.get(src);
      }

      function prewarmAppleMusicFrames() {
        if (!previewCard.classList.contains("is-visible")) {
          previewAppleMusicSlot.hidden = false;
        }

        const sources = new Set(
          Array.from(document.querySelectorAll(".wiki-link"))
            .map((link) => link.dataset.previewAppleMusic)
            .filter(Boolean),
        );

        sources.forEach((src) => getAppleMusicFrame(src));
      }

      function prewarmYoutubeFrames() {
        if (!previewCard.classList.contains("is-visible")) {
          previewYoutubeSlot.hidden = false;
        }

        const sources = new Set(
          Array.from(document.querySelectorAll(".wiki-link"))
            .map((link) => link.dataset.previewYoutube)
            .filter(Boolean),
        );

        sources.forEach((src) => getYoutubeFrame(src));
      }

      function showPreview(link) {
        window.clearTimeout(previewHideTimer);
        const appleMusicSrc = link.dataset.previewAppleMusic || "";
        const youtubeSrc = link.dataset.previewYoutube || "";
        const hasMediaPreview = Boolean(appleMusicSrc || youtubeSrc);

        previewTitle.textContent = link.dataset.previewTitle || link.textContent;
        previewBody.textContent = link.dataset.preview || "";
        previewBody.hidden = hasMediaPreview;
        previewAppleMusicSlot.hidden = !appleMusicSrc;
        previewYoutubeSlot.hidden = !youtubeSrc || Boolean(appleMusicSrc);
        previewCard.classList.toggle("has-apple-music", Boolean(appleMusicSrc));
        previewCard.classList.toggle("has-youtube", Boolean(!appleMusicSrc && youtubeSrc));
        previewCard.classList.add("is-visible");

        if (appleMusicSrc) {
          youtubeFrames.forEach((cachedFrame) => {
            parkYoutubeFrame(cachedFrame);
          });
          const frame = getAppleMusicFrame(appleMusicSrc);
          const frameLoaded = frame.dataset.loaded === "true";
          appleMusicFrames.forEach((cachedFrame) => {
            if (cachedFrame === frame) {
              cachedFrame.classList.add("is-active");
            } else {
              parkAppleMusicFrame(cachedFrame);
            }
          });
          frame.classList.toggle("is-loading", !frameLoaded);
          previewAppleMusicLoading.hidden = frameLoaded;
          previewYoutubeLoading.hidden = true;
        } else if (youtubeSrc) {
          appleMusicFrames.forEach((cachedFrame) => {
            parkAppleMusicFrame(cachedFrame);
          });
          const frame = getYoutubeFrame(youtubeSrc);
          const frameLoaded = frame.dataset.loaded === "true";
          youtubeFrames.forEach((cachedFrame) => {
            if (cachedFrame === frame) {
              cachedFrame.classList.add("is-active");
            } else {
              parkYoutubeFrame(cachedFrame);
            }
          });
          frame.classList.toggle("is-loading", !frameLoaded);
          previewYoutubeLoading.hidden = frameLoaded;
          previewAppleMusicLoading.hidden = true;
        } else {
          appleMusicFrames.forEach((cachedFrame) => {
            parkAppleMusicFrame(cachedFrame);
          });
          youtubeFrames.forEach((cachedFrame) => {
            parkYoutubeFrame(cachedFrame);
          });
          previewAppleMusicLoading.hidden = true;
          previewYoutubeLoading.hidden = true;
        }

        const rect = link.getBoundingClientRect();
        const cardWidth = appleMusicSrc || youtubeSrc ? 420 : 320;
        previewCard.style.left = `${Math.max(16, Math.min(rect.left, window.innerWidth - cardWidth - 16))}px`;
        previewCard.style.top = `${rect.bottom + window.scrollY + 8}px`;
      }

      previewCard.addEventListener("mouseenter", () => window.clearTimeout(previewHideTimer));
      previewCard.addEventListener("mouseleave", hidePreview);

      document.querySelectorAll(".wiki-link").forEach((link) => {
        link.addEventListener("mouseenter", () => showPreview(link));
        link.addEventListener("mouseleave", scheduleHidePreview);
      });

      prewarmAppleMusicFrames();
      prewarmYoutubeFrames();
    </script>
  </body>
</html>
